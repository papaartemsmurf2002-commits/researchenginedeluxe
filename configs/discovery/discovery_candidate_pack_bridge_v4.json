{
  "bridge_version": "discovery-candidate-pack-bridge-v1",
  "description": "Research-only audit config for evaluating discovery winners against the existing historical-cycle candidate-pack validator. This bridge writes eligibility evidence only and never writes candidate packs.",
  "research_only": true,
  "observe_only": true,
  "promotion_ready": false,
  "candidate_pack_written": false,
  "write_candidate_packs": false,
  "required_inputs": {
    "discovery_manifest_path": "set per run: data/research/discovery_runs/<run_id>/discovery_run_manifest.json",
    "exit_lab_manifest_path": "set per exit lab: data/research/discovery_exit_lab/<run_id>/discovery_exit_lab_manifest.json",
    "multiple_testing_manifest_path": "set per discovery multiple-testing report: data/research/discovery_multiple_testing/<run_id>/discovery_multiple_testing_manifest.json",
    "validation_floors_manifest_path": "set per validation-floor report: data/research/discovery_validation_floors/<run_id>/discovery_validation_floors_manifest.json",
    "cycle_manifest_path": "set per historical cycle: data/research/historical_cycles/<cycle_id>/research_cycle_manifest.json",
    "candidate_id_map_json": "{}"
  },
  "fail_closed_policy": [
    "discovery_run_manifest_version_required",
    "discovery_run_state_must_be_completed",
    "exit_lab_manifest_required",
    "exit_lab_status_complete_required",
    "exit_lab_candidate_gate_evidence_required",
    "exit_lab_non_fixed_improvement_required",
    "multiple_testing_manifest_required",
    "multiple_testing_candidate_gate_evidence_required",
    "multiple_testing_status_passed_required",
    "validation_floor_manifest_required",
    "validation_floor_candidate_gate_evidence_required",
    "candidate_ready_validation_required",
    "standard_blocker_registry_required",
    "isolated_large_grid_winner_blocked",
    "historical_cycle_manifest_required",
    "candidate_must_be_in_interesting_candidates",
    "candidate_must_not_be_in_blocked_candidates_or_filter_blockers",
    "existing_evaluate_research_candidate_gate_must_pass"
  ]
}
