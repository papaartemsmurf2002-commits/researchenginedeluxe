{
  "version": "v2-btc-hmm-knn-provider-pipeline-1",
  "asset_scope": ["BTCUSDT"],
  "output_dir": "data/research/v2-btc-hmm-knn-provider-pipeline-1",
  "providers": [
    {
      "source_name": "binance_vision",
      "enabled": true,
      "inputs": [],
      "local_file_input_examples": [
        {
          "path": "C:/path/to/BTCUSDT-15m-klines.zip",
          "symbol": "BTCUSDT",
          "data_family": "kline",
          "interval": "15m"
        },
        {
          "path": "C:/path/to/BTCUSDT-aggTrades.zip",
          "symbol": "BTCUSDT",
          "data_family": "agg_trade"
        },
        {
          "path": "C:/path/to/BTCUSDT-trades.zip",
          "symbol": "BTCUSDT",
          "data_family": "trade"
        }
      ],
      "download_input_examples": [
        {
          "symbol": "BTCUSDT",
          "data_family": "kline",
          "interval": "15m",
          "download": {
            "period": "2024-01-01",
            "cadence": "daily",
            "market": "futures/um",
            "verify_checksum": true
          }
        }
      ]
    },
    {
      "source_name": "crypto_lake",
      "enabled": true,
      "symbol": "BTCUSDT",
      "data_family": "trade",
      "inputs": [],
      "fallback_role": "free_sample_data_when_binance_vision_is_insufficient",
      "local_export_input_examples": [
        {
          "path": "C:/path/to/crypto_lake_btcusdt_1m.csv",
          "symbol": "BTCUSDT",
          "provider_symbol": "BTC-USDT-PERP",
          "data_family": "kline",
          "interval": "1m"
        }
      ],
      "free_sample_fetch_input_examples": [
        {
          "symbol": "BTCUSDT",
          "provider_symbol": "BTC-USDT-PERP",
          "data_family": "kline",
          "interval": "1m",
          "fetch": {
            "start_time": "2025-04-06",
            "end_time": "2025-04-07",
            "exchange": "BINANCE_FUTURES",
            "table": "candles"
          },
          "strict": true
        }
      ]
    },
    {
      "source_name": "hyperliquid_archive",
      "enabled": true,
      "symbol": "BTCUSDT",
      "data_family": "order_event",
      "inputs": []
    }
  ],
  "dataset_stage": {
    "enabled": true,
    "research_config": "configs/v2_btc_research.json",
    "db_path": "data/tradingbotsuite.sqlite3"
  },
  "evidence_stage": {
    "enabled": true,
    "hmm_knn_config": "configs/v2_btc_hmm_multi_knn_research.json",
    "experiment_spec": "configs/experiments/v2_btc_hmm_knn_current_artifact_experiments.json",
    "workers": 1,
    "write_monitoring": true
  }
}
